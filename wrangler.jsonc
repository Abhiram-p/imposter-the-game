{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imposter-the-game",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "observability": { "enabled": true },
  "vars": { "DISCORD_CLIENT_ID": "YOUR_DISCORD_APPLICATION_CLIENT_ID" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" },
      { "name": "ACTIVITY_SESSIONS", "class_name": "ActivitySession" }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ActivitySession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
